# ===========================================================
# Health Journey — Git ignore rules
# IBM Skillathon 2026
# ===========================================================

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Virtual environments -----------------------------------
.venv/
venv/
env/
ENV/
backend/venv/
backend/.venv/

# --- Secrets (NEVER commit) ---------------------------------
.env
*.env
!.env.example
backend/.env
secrets.json
credentials.json

# --- Node / frontend ----------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# --- User-uploaded medical documents ------------------------
# The folder is kept in the repo, its contents are private.
backend/uploads/*
!backend/uploads/.gitkeep

# --- Deprecated / superseded code ---------------------------
frontend_backup/

# --- Course material & recordings (not source code) ---------
*.pdf
!docs/**/*.pdf

# --- Design tool exports ------------------------------------
Health Journey Dashboard/
*.dc.html
.thumbnail

# --- Scratch files ------------------------------------------
bob prompts.txt
prompts/
screenshots/*.tmp

# --- Editor & OS --------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
