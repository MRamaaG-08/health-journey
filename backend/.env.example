# ---------------------------------------------------------------
# Health Journey — Backend environment variables
# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored and must never be committed.
# ---------------------------------------------------------------

# IBM watsonx.ai credentials.
# Leave these as-is (or blank) and IBM Bob automatically runs on its
# grounded local inference engine, so the app still works fully offline.
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai regional endpoint.
IBM_URL=https://us-south.ml.cloud.ibm.com

# Granite model that powers IBM Bob.
IBM_MODEL_ID=ibm/granite-3-8b-instruct

# Flask server port.
PORT=5000

# Flask debug mode. Keep this false for demos and graded runs.
FLASK_DEBUG=false
